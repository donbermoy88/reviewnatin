{
  "name": "reviewnatin",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "expo": "~56.0.0",
    "next": "16.2.6",
    "react-native": "0.85.3"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "mobile:clear": "npm run start --workspace=apps/mobile -- -c",
    "marketing": "npm run dev --workspace=apps/marketing",
    "admin": "npm run dev --workspace=apps/admin -- -p 3001",
    "db:push": "supabase db push",
    "supabase:setup": "node scripts/wait-and-setup-supabase.mjs",
    "supabase:login": "supabase login",
    "supabase:auth": "node scripts/configure-supabase-auth.mjs",
    "supabase:auth:prod": "node scripts/configure-supabase-auth.mjs --prod",
    "supabase:smtp": "node scripts/configure-supabase-smtp.mjs",
    "supabase:resend:setup": "node scripts/setup-resend-smtp.mjs",
    "supabase:resend:dns": "node scripts/provision-resend-dns-cloudflare.mjs",
    "beta:migrations": "node scripts/beta-apply-auth-migrations.mjs",
    "beta:automate": "node scripts/beta-automate-all.mjs",
    "beta:automate:local": "node scripts/beta-automate-all.mjs --skip-push",
    "beta:maestro": "node scripts/beta-maestro-run.mjs",
    "beta:force": "node scripts/beta-force-automate.mjs",
    "beta:wait-maestro": "node scripts/beta-wait-install-maestro.mjs --latest",
    "supabase:google": "node scripts/configure-google-auth.mjs",
    "supabase:android": "node scripts/configure-android-oauth.mjs",
    "supabase:google:setup": "node scripts/setup-google-oauth-interactive.mjs",
    "db:restore-catalog": "node scripts/restore-exam-catalog.mjs",
    "db:seed-catalog": "node scripts/seed-catalog.mjs",
    "db:seed-cse-topics": "node scripts/seed-cse-topics.mjs",
    "db:seed-questions": "node scripts/seed-demo-questions.mjs",
    "db:import-questions": "node scripts/import-questions.mjs",
    "db:refresh-mocks": "node scripts/refresh-mock-exams.mjs",
    "db:seed-content": "npm run db:seed-cse-topics && npm run db:seed-questions && npm run db:refresh-mocks",
    "db:apply-all": "node scripts/db-apply-all.mjs",
    "db:enable-demo-iap": "node scripts/enable-demo-iap.mjs",
    "content:audit": "node scripts/audit-content-quality.mjs",
    "content:audit:ci": "node scripts/audit-content-quality.mjs --fail-on medium",
    "content:audit:rules": "node --test scripts/lib/content-quality-rules.test.mjs",
    "content:import:rules": "node --test scripts/lib/question-import.test.mjs",
    "content:admin-import:ui": "node --test scripts/lib/admin-import-ui.test.mjs",
    "admin:proxy:rules": "node --test scripts/lib/admin-proxy.test.mjs",
    "mobile:ios:run": "npm run ios:run --workspace=apps/mobile",
    "mobile:ios:dev": "npm run ios:dev --workspace=apps/mobile",
    "mobile:ios:build-sim": "npm run ios:build-sim --workspace=apps/mobile",
    "mobile:lint": "npm run lint --workspace=apps/mobile",
    "mobile:typecheck": "npm run typecheck --workspace=apps/mobile",
    "mobile:test": "npm run test --workspace=apps/mobile",
    "admin:build": "npm run build --workspace=apps/admin",
    "admin:e2e": "npm run test:e2e --workspace=apps/admin",
    "marketing:build": "npm run build --workspace=apps/marketing",
    "web:build": "npm run admin:build && npm run marketing:build",
    "test": "npm run mobile:test",
    "db:gen-types": "node scripts/gen-db-types.mjs",
    "vercel:setup": "node scripts/setup-vercel.mjs",
    "vercel:secrets": "python3 scripts/setup-github-vercel-secrets.py",
    "vercel:git:deploy": "python3 scripts/vercel-git-deploy.py",
    "vercel:git:link": "node scripts/link-vercel-git.mjs",
    "admin:create": "node scripts/create-admin-user.mjs",
    "admin:repair-access": "node scripts/repair-admin-access.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs",
    "vercel:deploy:marketing": "npx vercel link --yes --project reviewnatin-marketing && npx vercel deploy --prod --yes --archive=tgz",
    "vercel:deploy:admin": "npx vercel link --yes --project reviewnatin-admin && npx vercel deploy --prod --yes --archive=tgz",
    "ci:local": "npm run mobile:lint && npm run mobile:typecheck && npm run lint --workspace=apps/admin && npm run lint --workspace=apps/marketing && npm run test && npm run content:audit:rules && npm run content:import:rules && npm run content:admin-import:ui && npm run admin:proxy:rules && npm run web:build",
    "prepare": "simple-git-hooks || true"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "apps/mobile/**/*.{ts,tsx,js,jsx}": [
      "bash -c 'cd apps/mobile && npx eslint --max-warnings=10000'"
    ],
    "apps/admin/**/*.{ts,tsx,js,jsx}": [
      "bash -c 'cd apps/admin && npx eslint --max-warnings=10000'"
    ],
    "apps/marketing/**/*.{ts,tsx,js,jsx}": [
      "bash -c 'cd apps/marketing && npx eslint --max-warnings=10000'"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.13.1",
    "vercel": "^54.4.1"
  }
}
