{
  "name": "reviewnatin",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "expo": "~56.0.0",
    "next": "16.2.6",
    "react-native": "0.85.3"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "mobile:clear": "npm run start --workspace=apps/mobile -- -c",
    "marketing": "npm run dev --workspace=apps/marketing",
    "admin": "npm run dev --workspace=apps/admin -- -p 3001",
    "db:push": "supabase db push",
    "supabase:setup": "node scripts/wait-and-setup-supabase.mjs",
    "supabase:login": "supabase login",
    "supabase:auth": "node scripts/configure-supabase-auth.mjs",
    "supabase:google": "node scripts/configure-google-auth.mjs",
    "supabase:android": "node scripts/configure-android-oauth.mjs",
    "supabase:google:setup": "node scripts/setup-google-oauth-interactive.mjs",
    "db:restore-catalog": "node scripts/restore-exam-catalog.mjs",
    "db:seed-catalog": "node scripts/seed-catalog.mjs",
    "db:seed-cse-topics": "node scripts/seed-cse-topics.mjs",
    "db:seed-questions": "node scripts/seed-demo-questions.mjs",
    "db:import-questions": "node scripts/import-questions.mjs",
    "db:refresh-mocks": "node scripts/refresh-mock-exams.mjs",
    "db:seed-content": "npm run db:seed-cse-topics && npm run db:seed-questions && npm run db:refresh-mocks",
    "db:apply-all": "node scripts/db-apply-all.mjs",
    "db:enable-demo-iap": "node scripts/enable-demo-iap.mjs",
    "mobile:ios:run": "npm run ios:run --workspace=apps/mobile",
    "mobile:ios:dev": "npm run ios:dev --workspace=apps/mobile",
    "mobile:ios:build-sim": "npm run ios:build-sim --workspace=apps/mobile",
    "mobile:lint": "npm run lint --workspace=apps/mobile",
    "mobile:test": "npm run test --workspace=apps/mobile",
    "test": "npm run mobile:test",
    "db:gen-types": "node scripts/gen-db-types.mjs",
    "vercel:setup": "node scripts/setup-vercel.mjs",
    "vercel:secrets": "python3 scripts/setup-github-vercel-secrets.py",
    "vercel:git:deploy": "python3 scripts/vercel-git-deploy.py",
    "vercel:git:link": "node scripts/link-vercel-git.mjs",
    "vercel:deploy:marketing": "npx vercel link --yes --project reviewnatin-marketing && npx vercel deploy --prod --yes --archive=tgz",
    "vercel:deploy:admin": "npx vercel link --yes --project reviewnatin-admin && npx vercel deploy --prod --yes --archive=tgz"
  },
  "devDependencies": {
    "vercel": "^54.4.1"
  }
}
