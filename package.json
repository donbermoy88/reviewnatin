{
  "name": "reviewnatin",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "expo": "~56.0.0",
    "next": "16.2.6",
    "react-native": "0.85.3"
  },
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "mobile:clear": "npm run start --workspace=apps/mobile -- -c",
    "marketing": "npm run dev --workspace=apps/marketing",
    "admin": "npm run dev --workspace=apps/admin -- -p 3001",
    "db:push": "supabase db push",
    "supabase:setup": "node scripts/wait-and-setup-supabase.mjs",
    "supabase:login": "supabase login",
    "supabase:auth": "node scripts/configure-supabase-auth.mjs"
  }
}
