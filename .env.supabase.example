# Copy to .env.supabase and fill in (gitignored)
# Get token: https://supabase.com/dashboard/account/tokens → Generate new token

SUPABASE_ACCESS_TOKEN=sbp_paste_here

# Optional overrides (setup script fills these after first run)
# SUPABASE_PROJECT_ID=
# SUPABASE_ORG_ID=
# SUPABASE_DB_PASSWORD=
# SUPABASE_REGION=ap-southeast-1
# SUPABASE_PROJECT_NAME=reviewnatin

# Google OAuth (Web client from Google Cloud Console)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# iOS client must use bundle ID ph.reviewnatin.app (NOT host.exp.Exponent / Expo Go)
# GOOGLE_OAUTH_IOS_CLIENT_ID=
