# Copy to .env.supabase and fill in (gitignored)
# Get token: https://supabase.com/dashboard/account/tokens → Generate new token

SUPABASE_ACCESS_TOKEN=sbp_paste_here

# Optional overrides (setup script fills these after first run)
# SUPABASE_PROJECT_ID=
# SUPABASE_ORG_ID=
# SUPABASE_DB_PASSWORD=
# SUPABASE_REGION=ap-southeast-1
# SUPABASE_PROJECT_NAME=reviewnatin

# Google OAuth (Web client from Google Cloud Console)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# iOS client must use bundle ID ph.reviewnatin.app (NOT host.exp.Exponent / Expo Go)
# GOOGLE_OAUTH_IOS_CLIENT_ID=

# OTP email (Resend SMTP → Supabase Auth). Run: npm run supabase:resend:setup
# RESEND_API_KEY=re_...
# SMTP_ADMIN_EMAIL=beta@reviewnatinph.com
# RESEND_FROM_EMAIL=beta@reviewnatinph.com
# Optional: auto-push Resend DNS to Cloudflare (reviewnatinph.com is on Cloudflare)
# CLOUDFLARE_API_TOKEN=          # https://dash.cloudflare.com/profile/api-tokens → Edit zone DNS
# CLOUDFLARE_ZONE_ID=19b1fa4b57943ba9c9cf89cc3455a0d8
# CLOUDFLARE_ACCOUNT_ID=4abfad3171c3b37a370f4d0ebd5f7ddc
# Or use any SMTP provider:
# SMTP_HOST=smtp.example.com SMTP_PORT=587 SMTP_USER=... SMTP_PASS=...
