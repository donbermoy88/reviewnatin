# Copy to .env.supabase (never commit .env.supabase)
# Get token: https://supabase.com/dashboard/account/tokens

SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# Optional — script will create project if omitted
# SUPABASE_PROJECT_ID=your_project_ref
# SUPABASE_DB_PASSWORD=your_secure_db_password
# SUPABASE_ORG_ID=your_org_uuid
# SUPABASE_PROJECT_NAME=reviewnatin
# SUPABASE_REGION=ap-southeast-1
