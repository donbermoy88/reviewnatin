{
  "name": "@reviewnatin/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/dom-webview": "~56.0.5",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@reviewnatin/shared": "*",
    "@sentry/react-native": "^7.10.0",
    "@supabase/supabase-js": "^2.106.1",
    "expo": "~56.0.3",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-auth-session": "~56.0.11",
    "expo-constants": "~56.0.14",
    "expo-dev-client": "~56.0.2",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.12",
    "expo-router": "~56.2.5",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.13",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "posthog-react-native": "^4.50.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-iap": "^14.7.7",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.1",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~56.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "android:dev": "node scripts/start-android-device.mjs",
    "android:dev:tunnel": "node scripts/start-android-device.mjs --tunnel",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo start --dev-client --ios",
    "eas:init": "eas init",
    "eas:build:ios:dev": "eas build --profile development-device --platform ios",
    "eas:build:ios:preview": "eas build --profile preview --platform ios",
    "eas:build:ios:prod": "eas build --profile production --platform ios",
    "eas:build:android:preview": "eas build --profile preview --platform android",
    "eas:build:android:prod": "npm run release:check:android && eas build --profile production --platform android",
    "release:check:android": "node scripts/check-android-release-env.mjs",
    "ios:run": "expo run:ios",
    "ios:build-sim": "node scripts/build-ios-simulator.mjs",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle:analyze": "node scripts/analyze-bundle.mjs",
    "generate-icons": "node scripts/generate-app-icons.mjs",
    "beta:phase0:verify": "npm --prefix ../.. run beta:phase0:verify",
    "beta:phase1:verify": "npm --prefix ../.. run beta:phase1:verify",
    "beta:phase2:verify": "npm --prefix ../.. run beta:phase2:verify",
    "beta:phase3:verify": "npm --prefix ../.. run beta:phase3:verify",
    "beta:phase4:verify": "npm --prefix ../.. run beta:phase4:verify",
    "beta:phase5:verify": "npm --prefix ../.. run beta:phase5:verify",
    "beta:release-notes": "npm --prefix ../.. run beta:release-notes",
    "beta:agents": "npm --prefix ../.. run beta:agents"
  },
  "private": true
}
