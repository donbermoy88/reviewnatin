# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Local build artifacts (large; never commit — already covered by .easignore for uploads)
*.apk
*.aab
build-*.apk

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# FCM / Google services credentials (provide via EAS secret or local file)
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android/app/build
/android/.gradle
/android/build

# App Store Connect API key directory (the .p8 itself is already ignored above)
credentials/
