EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google Sign-In (from Google Cloud → OAuth 2.0 Web + iOS + Android clients)
# iOS client bundle ID must be ph.reviewnatin.app (dev/App Store build — not Expo Go)
# Android client uses package ph.reviewnatin.app + the build's SHA-1 (debug keystore
# for local dev, Play App Signing SHA-1 for store builds). See scripts/configure-android-oauth.mjs.
# Enable on Supabase: npm run supabase:google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# AdMob (requires EAS / dev client rebuild — not Expo Go)
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=

# PostHog (product analytics, dashboard funnels, microinteractions)
# Create project at https://posthog.com — use US or EU ingest host
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile (signup CAPTCHA — required for prod/beta OTP signup)
# Site key: set in EAS preview/production env. Secret: .env.supabase → npm run supabase:captcha
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
