EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google Sign-In (from Google Cloud → OAuth 2.0 Web + iOS clients)
# iOS client bundle ID must be ph.reviewnatin.app (dev/App Store build — not Expo Go)
# Enable on Supabase: npm run supabase:google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# AdMob (requires EAS / dev client rebuild — not Expo Go)
# Set both app IDs before setting banner/interstitial unit IDs.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
