    "source_path": "/Users/lyndon/All reviewers/-LET REVIEWER 2026/C. MAJOR SUBJECTS/F. SOCIAL SCIENCE - SOCIAL STUDIES/Essential Reviewers/11. LIFE AND WORKS OF DR. JOSE P. RIZAL.pdf",
    "exam_scope": "secondary",
    "subject_slug": "major",
