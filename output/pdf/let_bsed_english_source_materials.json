    "source_file": "1. ENGLISH MAJOR NOTES.pdf",
    "source_type": "pdf",
    "source_path": "/Users/lyndon/All reviewers/-LET REVIEWER 2026/C. MAJOR SUBJECTS/A. ENGLISH/ESSENTIAL NOTES & DRILLS/1. ENGLISH MAJOR NOTES.pdf",
