    "source_type": "docx",
    "source_path": "/Users/lyndon/All reviewers/-LET REVIEWER 2026/C. MAJOR SUBJECTS/A. ENGLISH/ESSENTIAL NOTES & DRILLS/8. ENGLISH SPECIALIZATION.docx",
    "exam_scope": "secondary",
