    "source_path": "/Users/lyndon/All reviewers/-LET REVIEWER 2026/C. MAJOR SUBJECTS/A. ENGLISH/LITERATURE/1. A BRIEF HISTORY OF ENGLISH LITERATURE.pdf",
    "exam_scope": "secondary",
